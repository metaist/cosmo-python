# Cosmopolitan Python 3.10 static modules
# Format: module_name source.c [...] [-Dflag] [-Ipath] [-Lpath] [-llib]

*static*

# Math
math mathmodule.c
cmath cmathmodule.c

# Data structures
_struct _struct.c
array arraymodule.c
_bisect _bisectmodule.c
_heapq _heapqmodule.c
_queue _queuemodule.c
_random _randommodule.c

# Async
_asyncio _asynciomodule.c
_contextvars _contextvarsmodule.c

# Date/time
_datetime _datetimemodule.c

# IO/Network
_socket socketmodule.c
select selectmodule.c
mmap mmapmodule.c
fcntl fcntlmodule.c

# Binary/Serialization
binascii binascii.c
_pickle _pickle.c
_json _json.c
_csv _csv.c

# Compression
zlib zlibmodule.c
_bz2 _bz2module.c -lbz2
_lzma _lzmamodule.c -llzma

# Hashing - builtin implementations
_md5 md5module.c
_sha1 sha1module.c
_sha256 sha256module.c
_sha512 sha512module.c
_blake2 _blake2/blake2module.c _blake2/blake2b_impl.c _blake2/blake2s_impl.c
_sha3 _sha3/sha3module.c

# SSL/TLS
_ssl _ssl.c -lssl -lcrypto
_hashlib _hashopenssl.c -lssl -lcrypto

# Database
# Note: We disable extension loading and shared cache since our sqlite build doesn't support them
_sqlite3 _sqlite/cache.c _sqlite/connection.c _sqlite/cursor.c _sqlite/microprotocols.c _sqlite/module.c _sqlite/prepare_protocol.c _sqlite/row.c _sqlite/statement.c _sqlite/util.c -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_OMIT_SHARED_CACHE -lsqlite3
_gdbm _gdbmmodule.c -lgdbm

# System/POSIX
_posixsubprocess _posixsubprocess.c
grp grpmodule.c
resource resource.c
syslog syslogmodule.c
termios termios.c

# Unicode
unicodedata unicodedata.c

# CJK codecs
_multibytecodec cjkcodecs/multibytecodec.c
_codecs_cn cjkcodecs/_codecs_cn.c
_codecs_hk cjkcodecs/_codecs_hk.c
_codecs_iso2022 cjkcodecs/_codecs_iso2022.c
_codecs_jp cjkcodecs/_codecs_jp.c
_codecs_kr cjkcodecs/_codecs_kr.c
_codecs_tw cjkcodecs/_codecs_tw.c

# Decimal - high precision arithmetic (uses embedded libmpdec)
# Note: -DCONFIG_64 without =1 still defines it as 1
_decimal _decimal/_decimal.c _decimal/libmpdec/basearith.c _decimal/libmpdec/constants.c _decimal/libmpdec/context.c _decimal/libmpdec/convolute.c _decimal/libmpdec/crt.c _decimal/libmpdec/difradix2.c _decimal/libmpdec/fnt.c _decimal/libmpdec/fourstep.c _decimal/libmpdec/io.c _decimal/libmpdec/mpalloc.c _decimal/libmpdec/mpdecimal.c _decimal/libmpdec/numbertheory.c _decimal/libmpdec/sixstep.c _decimal/libmpdec/transpose.c -I$(srcdir)/Modules/_decimal/libmpdec -DCONFIG_64 -DANSI -DHAVE_UINT128_T

# XML parsing
pyexpat expat/xmlparse.c expat/xmlrole.c expat/xmltok.c pyexpat.c -I$(srcdir)/Modules/expat -DHAVE_EXPAT_CONFIG_H -DXML_POOR_ENTROPY -DUSE_PYEXPAT_CAPI
_elementtree _elementtree.c -I$(srcdir)/Modules/expat -DHAVE_EXPAT_CONFIG_H -DUSE_PYEXPAT_CAPI

# Misc
_statistics _statisticsmodule.c
_lsprof _lsprof.c rotatingtree.c
_opcode _opcode.c
_zoneinfo _zoneinfo.c

# Readline
readline readline.c -lreadline -ltinfo

# Curses (TUI)
_curses _cursesmodule.c -lncursesw -ltinfo
_curses_panel _curses_panel.c -lpanelw -lncursesw -ltinfo

# Multiprocessing
_multiprocessing _multiprocessing/multiprocessing.c _multiprocessing/semaphore.c
_posixshmem _multiprocessing/posixshmem.c

# FFI/ctypes
# Note: pythonapi requires dlopen(NULL) which Cosmopolitan doesn't support.
# Our ctypes-cosmopolitan.patch sets pythonapi=None as a fallback.
# Basic ctypes functionality (structs, arrays, c types) still works.
_ctypes _ctypes/_ctypes.c _ctypes/callbacks.c _ctypes/callproc.c _ctypes/stgdict.c _ctypes/cfield.c -lffi
